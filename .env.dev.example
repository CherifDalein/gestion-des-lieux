# Development overrides
# Copy to `.env.dev` for machine-specific values.

# Required: JWT secret (HS512 => keep it long)
AUTH_TOKEN_JWT_SECRET=CHANGE_ME_DEV_ONLY_CHANGE_ME_DEV_ONLY_CHANGE_ME_DEV_ONLY_CHANGE_ME_1234

# Local database override
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/lieux_db;MODE=MySQL;DB_CLOSE_DELAY=-1

# Local uploads directory override
APP_UPLOAD_DIR=./uploads/images

# Local base URL
APP_SHARE_BASE_URL=http://localhost:8080
