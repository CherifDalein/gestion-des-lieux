# Production-like env (Render friendly)
# Prefer setting these as platform env vars.

# Required: JWT secret (HS512 => keep it long)
AUTH_TOKEN_JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# H2 in-memory (data resets on restart/redeploy)
SPRING_DATASOURCE_URL=jdbc:h2:mem:lieux_db;MODE=MySQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# Temporary uploads directory
APP_UPLOAD_DIR=/tmp/uploads/images

# Public base URL used in shared links
APP_SHARE_BASE_URL=https://gestion-des-lieux.onrender.com
